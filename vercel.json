{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "cd apps/app && bun run build",
  "outputDirectory": "apps/app/dist",
  "headers": [
    {
      "source": "/(.*).(html|js|css|wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/start",
      "has": [
        {
          "type": "host",
          "value": "huntlog.dev"
        }
      ],
      "destination": "https://app.huntlog.dev/start",
      "permanent": false
    },
    {
      "source": "/settings",
      "has": [
        {
          "type": "host",
          "value": "huntlog.dev"
        }
      ],
      "destination": "https://app.huntlog.dev/settings",
      "permanent": false
    },
    {
      "source": "/leads",
      "has": [
        {
          "type": "host",
          "value": "huntlog.dev"
        }
      ],
      "destination": "https://app.huntlog.dev/leads",
      "permanent": false
    },
    {
      "source": "/resources",
      "has": [
        {
          "type": "host",
          "value": "huntlog.dev"
        }
      ],
      "destination": "https://app.huntlog.dev/resources",
      "permanent": false
    },
    {
      "source": "/applications/:path*",
      "has": [
        {
          "type": "host",
          "value": "huntlog.dev"
        }
      ],
      "destination": "https://app.huntlog.dev/applications/:path*",
      "permanent": false
    }
  ]
}
